{
  "name": "mcp-deps-audit",
  "version": "0.1.0",
  "description": "MCP server and CLI that audit project dependencies — unused, missing, outdated, licenses, and vulnerabilities across npm and PyPI.",
  "type": "module",
  "license": "MIT",
  "author": "KaryawanSurga",
  "homepage": "https://github.com/KaryawanSurga/mcp-deps-audit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaryawanSurga/mcp-deps-audit.git"
  },
  "bugs": {
    "url": "https://github.com/KaryawanSurga/mcp-deps-audit/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dependencies",
    "audit",
    "npm",
    "pypi",
    "vulnerabilities",
    "licenses",
    "ai-agents",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-deps-audit": "dist/index.js",
    "depsaudit": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
